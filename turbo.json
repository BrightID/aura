{
  "$schema": "https://v2-9-6.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "VITE_SOME_FIREBASE_API_KEY",
    "VITE_SOME_FIREBASE_AUTH_DOMAIN",
    "VITE_SOME_FIREBASE_PROJECT_ID",
    "VITE_SOME_FIREBASE_STORAGE_BUCKET",
    "VITE_SOME_FIREBASE_MESSAGING_SENDER_ID",
    "VITE_SOME_FIREBASE_APP_ID",
    "VITE_SOME_FIREBASE_MEASUREMENT_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@aura/landing#build": {
      "dependsOn": [
        "^build",
        "@aura/core#build",
        "aura-dashboard#build",
        "@aura/demo-integration#build",
        "@aura/interface#build"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
