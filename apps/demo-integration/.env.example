# Origin that serves the Aura verification embed (/embed/projects/:id).
# Defaults to production. Point at http://localhost:5173 to test against a
# locally running interface app (bun dev in apps/interface).
VITE_AURA_EMBED_BASE_URL=https://aura-get-verified.vercel.app

# Project to verify against (see the dashboard for project ids). Dev page uses 9.
VITE_AURA_PROJECT_ID=9
