{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/demo/:path*",
      "destination": "/demo/index.html"
    },
    {
      "source": "/((?!demo(?:/|$)).*)",
      "destination": "https://aura.brightid.org/$1"
    }
  ]
}
