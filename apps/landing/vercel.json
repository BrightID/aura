{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/profile/upload/:channelId",
      "destination": "/api/profile-upload?channelId=:channelId"
    },
    {
      "source": "/profile/upload/:channelId",
      "destination": "/api/profile-upload?channelId=:channelId"
    },
    {
      "source": "/operations/:hash",
      "destination": "/api/operations?hash=:hash"
    },
    {
      "source": "/operations",
      "destination": "/api/operations"
    },
    {
      "source": "/api/projects/:id/verify",
      "destination": "/api/project-verify?id=:id"
    },
    {
      "source": "/api/projects/:id/usage",
      "destination": "/api/project-usage?id=:id"
    },
    {
      "source": "/api/payments/status/:orderId",
      "destination": "/api/payment-status?orderId=:orderId"
    },
    {
      "source": "/interface/api/:path(.*)?",
      "destination": "/api/:path"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
