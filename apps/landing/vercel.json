{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/profile/upload/:channelId",
      "destination": "/api/profile/upload/:channelId"
    },
    {
      "source": "/interface/api/:path(.*)?",
      "destination": "/api/:path"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
