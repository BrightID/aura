{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "./build/client",
  "routes": [
    {
      "src": "/dashboard/assets/(.*)",
      "dest": "/dashboard/assets/$1"
    },
    {
      "src": "/dashboard/images/(.*)",
      "dest": "/dashboard/images/$1"
    },
    {
      "src": "/dashboard/favicon\\.ico",
      "dest": "/dashboard/favicon.ico"
    },
    {
      "src": "/dashboard(/.*)?",
      "dest": "/dashboard/index.html"
    }
  ]
}
